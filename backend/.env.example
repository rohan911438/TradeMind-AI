# Copy to backend/.env and fill in.
# Google OAuth Client ID (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID -> Web application)
# Authorised JavaScript origins: http://localhost:8000 (and your deployed URL)
GOOGLE_CLIENT_ID=

# Optional
# SECRET_KEY=change-me-to-a-long-random-string
# HTTPS_ONLY=true          # set on HTTPS deployments
# EVENTS_PER_SEC=200
# BAR_SECONDS=10
# STARTING_CAPITAL=1000000
